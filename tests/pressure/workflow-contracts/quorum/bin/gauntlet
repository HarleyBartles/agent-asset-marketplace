#!/usr/bin/env bash
set -euo pipefail

marketplace_root=$(realpath "$(dirname "$0")/../../../../../")
gauntlet_root="$marketplace_root/evals/gauntlet"

test -f "$gauntlet_root/package.json"
test -d "$gauntlet_root/node_modules"
export OPENAI_API_KEY=${ANTHROPIC_API_KEY:?Quorum grader bridge did not receive its credential}
unset ANTHROPIC_API_KEY
exec npx --yes bun run "$gauntlet_root/src/index.ts" "$@"
