                "tools/validate_marketplace.py",
                "tools/validate_repo_index.py"
            ]
        },
        {
            "name": "house-skills-source-ledger",
            "path": "sources/house-skills",
            "purpose": "House Skills source ledger and boundary records used to project the bundle.",
            "surface_kind": "provenance",
            "nearest_scoped_agents_md": null,
            "key_validation_scripts": [
                "tools/validate_marketplace.py"
            ]
        },
        {
            "name": "gpt-skills-root",
            "path": "gpt-skills",
