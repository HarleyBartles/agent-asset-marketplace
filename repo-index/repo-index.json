            "surface_kind": "hand-authored",
            "nearest_scoped_agents_md": "gpt-skills/AGENTS.md",
            "key_validation_scripts": [
                "tools/validate_repo_index.py"
            ]
        },
        {
            "name": "gpt-house-skills",
            "path": "gpt-skills/house-skills",
            "purpose": "Harley-authored first-party House Skills sources only.",
            "surface_kind": "hand-authored",
            "nearest_scoped_agents_md": "gpt-skills/house-skills/AGENTS.md",
            "key_validation_scripts": [
                "tools/validate_repo_index.py"
            ]
        },
        {
            "name": "vendor-custody",
            "path": "sources/vendor",
            "purpose": "Third-party source custody, upstream snapshots, and vendor evidence.",
            "surface_kind": "vendored",
            "nearest_scoped_agents_md": "sources/vendor/AGENTS.md",
            "guidance_scope": "repo-owned-guidance",
            "notes": "Nested upstream AGENTS.md files remain vendor package instructions, not repository doctrine.",
            "key_validation_scripts": [
                "tools/validate_repo_index.py",
                "tools/validate_marketplace.py"
            ]
        },
        {
            "name": "provenance",
            "path": "provenance",
            "purpose": "Provenance notes, activity logs, trust records, and custody evidence.",
            "surface_kind": "provenance",
            "nearest_scoped_agents_md": "provenance/AGENTS.md",
            "key_validation_scripts": [
                "tools/validate_repo_index.py"
            ]
        },
        {
            "name": "tools",
            "path": "tools",
            "purpose": "Repository validation and generation scripts.",
            "surface_kind": "hand-authored",
            "nearest_scoped_agents_md": "tools/AGENTS.md",
            "key_validation_scripts": [
                "tools/validate_marketplace.py",
                "tools/validate_repo_index.py",
                "tools/generate_marketplace.py"
            ]
        },
        {
            "name": "repo-index",
            "path": "repo-index",
            "purpose": "Navigation metadata for repo traversal and future corpus preparation.",
            "surface_kind": "generated",
            "nearest_scoped_agents_md": null,
            "key_validation_scripts": [
                "tools/validate_repo_index.py"
            ]
        }
    ],
