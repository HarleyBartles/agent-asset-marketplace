      "surface_kind": "runtime-facing",
      "nearest_scoped_agents_md": "codex-marketplace/plugins/AGENTS.md",
      "key_validation_scripts": [
        "tools/validate_marketplace.py",
        "tools/validate_repo_index.py"
      ]
    },
    {
      "name": "frontend-pack",
