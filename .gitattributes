# Enforce LF line endings in the working tree for all text files, matching the
# Linux-based CI runner and core.autocrlf=false policy. Binary overrides follow.
* text=auto eol=lf

# Shell and PowerShell scripts distributed in the repo must be LF too.
*.sh text eol=lf
*.ps1 text eol=lf
*.bash text eol=lf

# Upstream reference sources may retain trailing whitespace; do not lint them.
**/reference-source/** -whitespace

# Binary asset families: never perform line-ending normalization or diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar.gz binary
*.gz binary

# Generated install archives are binary and regenerated by tooling.
generated/skill-zips/**/*.zip binary
# Ignore generated skill zips - always regenerated by tooling
generated/skill-zips/**/*.zip linguist-generated
