#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pre-commit [--hosted <commit>] [--help]
Run the candidate-preserving repository check gate.
EOF
}

if [[ "${1:-}" == "--help" ]]; then usage; exit 0; fi
if [[ -n "${REPO_STANDARDS_HOSTED_COMMIT:-}" ]]; then
  [[ $# -eq 0 ]] || { printf 'pre-commit: hosted commit mode does not accept hook arguments\n' >&2; exit 2; }
  set -- --hosted "$REPO_STANDARDS_HOSTED_COMMIT"
fi
MODE=local
REQUESTED_COMMIT=
if [[ "${1:-}" == "--hosted" && $# -eq 2 ]]; then MODE=hosted; REQUESTED_COMMIT=$2
elif [[ $# -ne 0 ]]; then usage >&2; exit 2
fi

fail() { printf 'pre-commit: %s\n' "$*" >&2; exit 2; }
SOURCE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'not inside a Git checkout'
SOURCE_ROOT=$(cd "$SOURCE_ROOT" && pwd -P)
cd "$SOURCE_ROOT"

if [[ "$MODE" == hosted ]]; then
  [[ -z "$(git status --porcelain --untracked-files=all)" ]] || fail 'hosted gate requires a clean checkout'
  [[ "$(git symbolic-ref -q HEAD || true)" == "" ]] || fail 'hosted gate requires a detached checkout'
  HEAD_COMMIT=$(git rev-parse HEAD) || fail 'hosted gate cannot resolve HEAD'
  [[ "$HEAD_COMMIT" == "$REQUESTED_COMMIT" ]] || fail "hosted commit $REQUESTED_COMMIT does not match checkout HEAD $HEAD_COMMIT"
  CANDIDATE_TREE=$(git rev-parse "$REQUESTED_COMMIT^{tree}") || fail 'hosted commit has no tree'
  parent_line=$(git rev-list --parents -n 1 "$REQUESTED_COMMIT" 2>/dev/null || true)
  read -r _ VALIDATION_PARENT <<< "$parent_line"
else
  CANDIDATE_TREE=$(git write-tree 2>/dev/null) || fail 'cannot snapshot the candidate index tree'
  VALIDATION_PARENT=$(git rev-parse --verify HEAD 2>/dev/null || true)
fi

ORIGIN_REFS=$(git for-each-ref --format='%(refname) %(objectname)' refs/remotes/origin)
COMMON_DIR=$(git rev-parse --git-common-dir)
if [[ "$COMMON_DIR" != /* && ! "$COMMON_DIR" =~ ^[A-Za-z]:[/\\] ]]; then COMMON_DIR="$SOURCE_ROOT/$COMMON_DIR"; fi
COMMON_DIR=$(cd "$COMMON_DIR" && pwd -P)
SOURCE_OBJECTS="$COMMON_DIR/objects"
MAIN_CHECKOUT=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)
[[ -n "$MAIN_CHECKOUT" ]] || fail 'cannot identify the main checkout for scratch placement'
MAIN_CHECKOUT=$(cd "$MAIN_CHECKOUT" && pwd -P)
MAIN_COMMON_DIR=$(git -C "$MAIN_CHECKOUT" rev-parse --git-common-dir)
if [[ "$MAIN_COMMON_DIR" != /* && ! "$MAIN_COMMON_DIR" =~ ^[A-Za-z]:[/\\] ]]; then MAIN_COMMON_DIR="$MAIN_CHECKOUT/$MAIN_COMMON_DIR"; fi
MAIN_COMMON_DIR=$(cd "$MAIN_COMMON_DIR" && pwd -P)
[[ "$MAIN_COMMON_DIR" == "$COMMON_DIR" ]] || fail 'main checkout and source checkout do not share the expected Git common directory'
REPOSITORY_NAME=$(basename "$MAIN_CHECKOUT")
TEMP_PARENT="$(dirname "$MAIN_CHECKOUT")/_agent-scratch/$REPOSITORY_NAME"
mkdir -p "$TEMP_PARENT" || fail "cannot create canonical scratch directory $TEMP_PARENT"
TEMP_PARENT=$(cd "$TEMP_PARENT" && pwd -P)
case "$TEMP_PARENT/" in "$SOURCE_ROOT/"*) fail 'temporary gate directory must be outside the author checkout' ;; esac
GATE_ROOT=$(mktemp -d "$TEMP_PARENT/tracked-hook-candidate.XXXXXX") || fail 'cannot create disposable candidate checkout'
GATE_ROOT=$(cd "$GATE_ROOT" && pwd -P)
case "$GATE_ROOT/" in "$TEMP_PARENT/tracked-hook-candidate."*) ;; *) fail 'temporary candidate path failed containment check' ;; esac

GATE_STATUS=0
GATE_MUTATED=0
cleanup() {
  local prior=$?
  trap - EXIT
  case "$GATE_ROOT/" in
    "$TEMP_PARENT/tracked-hook-candidate."*)
      if [[ -d "$GATE_ROOT" ]]; then rm -rf -- "$GATE_ROOT" || { printf 'pre-commit: could not remove disposable gate checkout %s; remove it manually\n' "$GATE_ROOT" >&2; prior=2; }; fi
      ;;
    *) printf 'pre-commit: refusing unsafe cleanup path %s\n' "$GATE_ROOT" >&2; prior=2 ;;
  esac
  if [[ $prior -eq 0 && $GATE_MUTATED -eq 1 ]]; then prior=1; fi
  exit "$prior"
}
trap cleanup EXIT

# The author index has already been snapshotted. Remove inherited repository context before operating on the gate clone.
while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)

if ! git clone --quiet --shared --no-checkout -- "$SOURCE_ROOT" "$GATE_ROOT" 2>/dev/null; then
  # Git cannot clone an unborn repository. Initialize the isolated repository and point its objects at the source.
  git -C "$GATE_ROOT" init --quiet || fail 'cannot initialize disposable candidate checkout'
  mkdir -p "$GATE_ROOT/.git/objects/info"
  printf '%s\n' "$SOURCE_OBJECTS" > "$GATE_ROOT/.git/objects/info/alternates"
fi
git -C "$GATE_ROOT" config core.autocrlf false
while IFS= read -r ref; do
  [[ -n "$ref" && "$ref" != refs/remotes/origin/HEAD ]] && git -C "$GATE_ROOT" update-ref -d "$ref"
done < <(git -C "$GATE_ROOT" for-each-ref --format='%(refname)' refs/remotes/origin)
while IFS= read -r refline; do
  [[ -n "$refline" ]] || continue
  read -r ref oid <<< "$refline"
  [[ "$ref" == refs/remotes/origin/HEAD ]] && continue
  git -C "$GATE_ROOT" update-ref "$ref" "$oid" || fail "cannot preserve source remote ref $ref"
done <<< "$ORIGIN_REFS"
if [[ -n "$VALIDATION_PARENT" ]]; then
  git -C "$GATE_ROOT" update-ref --no-deref HEAD "$VALIDATION_PARENT" || fail 'cannot set candidate validation parent'
else
  git -C "$GATE_ROOT" symbolic-ref HEAD refs/heads/gate-unborn
  git -C "$GATE_ROOT" update-ref -d refs/heads/gate-unborn
fi
git -C "$GATE_ROOT" read-tree "$CANDIDATE_TREE" || fail 'cannot load candidate index tree'
git -C "$GATE_ROOT" checkout-index --all --force || fail 'cannot materialize candidate files'
GATE_INITIAL_TREE=$(git -C "$GATE_ROOT" write-tree) || fail 'cannot snapshot disposable candidate index'

REPO_ROOT=$GATE_ROOT
REPO_STANDARDS_STAGED_SNAPSHOT=1
export REPO_ROOT REPO_STANDARDS_STAGED_SNAPSHOT
cd "$GATE_ROOT"
ADAPTER="$GATE_ROOT/tools/hook_gate_adapter.sh"
[[ -f "$ADAPTER" ]] || fail 'candidate hook gate adapter is not configured'
source "$ADAPTER" || fail 'candidate hook gate adapter could not be loaded'
declare -F run_repository_check_gate >/dev/null || fail 'candidate adapter must define run_repository_check_gate()'

set +e
run_repository_check_gate
GATE_STATUS=$?
set -e

if ! git -C "$GATE_ROOT" diff --quiet || [[ -n "$(git -C "$GATE_ROOT" ls-files --others --exclude-standard)" ]]; then
  printf 'pre-commit: check gate changed candidate files; checks must not modify maintained files\n' >&2
  GATE_MUTATED=1
fi
if [[ "$(git -C "$GATE_ROOT" write-tree 2>/dev/null || true)" != "$GATE_INITIAL_TREE" ]]; then
  printf 'pre-commit: check gate changed the candidate index\n' >&2
  GATE_MUTATED=1
fi
if [[ $GATE_STATUS -ne 0 ]]; then exit "$GATE_STATUS"; fi
if [[ $GATE_MUTATED -eq 1 ]]; then exit 1; fi
exit 0
