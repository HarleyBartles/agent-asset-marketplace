# Generated outputs
generated/*
!generated/.gitignore
!generated/INDEX.md
!generated/reports/
!generated/reports/.gitignore

# Temporary and local tooling artifacts
.cache/
.eslintcache
.idea/
.vscode/
__pycache__/
.pytest_cache/
*.pyc
node_modules/
dist/
build/
coverage/
tmp/
temp/

# Package and archive noise
*.tgz
*.tar
*.tar.gz
*.zip
# Vendored first-party source snapshots are source custody, not build noise
!sources/first_party/**/assets/authority/reference-source/**/*.tar.gz
!sources/first_party/**/assets/authority/reference-source/**/*.zip
!codex-marketplace/plugins/**/assets/authority/reference-source/**/*.tar.gz
!codex-marketplace/plugins/**/assets/authority/reference-source/**/*.zip
!generated/skill-zips/
!generated/skill-zips/**/
!generated/skill-zips/**
!generated/skill-zips/**/*.zip

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Environment and secrets
.env
.env.*
!.env.example

.codex/environments/environment.toml

# .superpowers/ is the obra-superpowers upstream default output directory.
# This repo standardizes on .agents/superpowers/; keep this ignore to avoid
# accidentally tracking any stale .superpowers/ workspace that appears.
.superpowers/
