# Temporary and local tooling artifacts
.cache/
.eslintcache
.idea/
.vscode/
__pycache__/
.pytest_cache/
*.pyc
node_modules/
build/
!/tests/build/
coverage/

# Package and archive noise
*.tgz
*.tar
*.tar.gz
*.zip
# Authority source snapshots and their packaged copies are not build noise.
!skills/**/assets/authority/reference-source/**/*.tar.gz
!skills/**/assets/authority/reference-source/**/*.zip
!dist/plugins/**/assets/authority/reference-source/**/*.tar.gz
!dist/plugins/**/assets/authority/reference-source/**/*.zip

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Environment and secrets
.env
.env.*
!.env.example

.codex/environments/environment.toml

# .superpowers/ is the obra-superpowers upstream default output directory.
# This repo uses .agents/ for tracked agent-facing surfaces and external
# scratch/worktree locations for local workspaces. Keep this ignore to avoid
# accidentally tracking any stale .superpowers/ workspace that appears.
.superpowers/

# Local-only pressure campaign traces.
skills/**/tests/pressure/**/runs/

# Local evaluation harness clones.
evals/
