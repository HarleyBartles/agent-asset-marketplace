# Generated outputs
generated/*
!generated/.gitignore
!generated/INDEX.md
!generated/reports/
!generated/reports/.gitignore

# Temporary and local tooling artifacts
.cache/
.eslintcache
.idea/
.vscode/
__pycache__/
.pytest_cache/
*.pyc
node_modules/
dist/
build/
coverage/
tmp/
temp/

# Package and archive noise
*.tgz
*.tar
*.tar.gz
*.zip
!generated/skill-zips/
!generated/skill-zips/**/
!generated/skill-zips/**
!generated/skill-zips/**/*.zip

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Environment and secrets
.env
.env.*
!.env.example

.codex/environments/environment.toml

# Superpowers SDD and specs are local-only working surfaces.
# Track only the directory scaffold (.gitignore); ignore all session contents.
# plans/ is fully repo resident and not governed by this block.
.agents/superpowers/sdd/*
!.agents/superpowers/sdd/.gitignore
.agents/superpowers/specs/*
!.agents/superpowers/specs/.gitignore
.superpowers/
