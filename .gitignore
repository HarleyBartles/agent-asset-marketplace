# Generated outputs
generated/*
!generated/.gitignore
!generated/INDEX.md
!generated/reports/
!generated/reports/.gitignore

# Temporary and local tooling artifacts
.cache/
.eslintcache
.idea/
.vscode/
__pycache__/
.pytest_cache/
*.pyc
node_modules/
dist/
build/
coverage/
tmp/
temp/

# Package and archive noise
*.tgz
*.tar
*.tar.gz
*.zip
!generated/skill-zips/
!generated/skill-zips/**/
!generated/skill-zips/**
!generated/skill-zips/**/*.zip

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Environment and secrets
.env
.env.*
!.env.example

.codex/environments/environment.toml

# Local Devin/Codex issue worktrees
.worktrees/*
!.worktrees/AGENTS.md

# Superpowers SDD and specs are local-only working surfaces
.agents/superpowers/sdd/
.agents/superpowers/specs/
.superpowers/
