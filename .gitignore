# Generated outputs
generated/*
!generated/.gitignore
!generated/INDEX.md
!generated/reports/
!generated/reports/.gitignore

# Temporary and local tooling artifacts
.cache/
.eslintcache
.idea/
.vscode/
__pycache__/
.pytest_cache/
*.pyc
node_modules/
dist/
build/
coverage/

# Package and archive noise
*.tgz
*.tar
*.tar.gz
*.zip
# Vendored source snapshots in plugin authority are source custody, not build noise
!codex-marketplace/plugins/**/assets/authority/reference-source/**/*.tar.gz
!codex-marketplace/plugins/**/assets/authority/reference-source/**/*.zip

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log

# Environment and secrets
.env
.env.*
!.env.example

.codex/environments/environment.toml

# .superpowers/ is the obra-superpowers upstream default output directory.
# This repo uses .agents/ for tracked agent-facing surfaces and external
# scratch/worktree locations for local workspaces. Keep this ignore to avoid
# accidentally tracking any stale .superpowers/ workspace that appears.
.superpowers/
