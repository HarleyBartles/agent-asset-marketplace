{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarleyBartles/agent-asset-marketplace/operating-standards.schema.json",
  "title": "Consumer operating standards composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "standards"],
  "properties": {
    "version": { "const": 1 },
    "standards": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "origin", "revision", "implementation_root", "check", "apply", "generated_paths", "requires"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "origin": { "const": "marketplace" },
              "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
              "implementation_root": { "type": "string", "minLength": 1 },
              "check": { "$ref": "#/$defs/command" },
              "apply": { "$ref": "#/$defs/command" },
              "generated_paths": { "$ref": "#/$defs/paths" },
              "requires": { "$ref": "#/$defs/ids" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "origin", "implementation_root", "check", "apply", "generated_paths", "requires"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "origin": { "const": "repository" },
              "implementation_root": { "type": "string", "minLength": 1 },
              "check": { "$ref": "#/$defs/command" },
              "apply": { "$ref": "#/$defs/command" },
              "generated_paths": { "$ref": "#/$defs/paths" },
              "requires": { "$ref": "#/$defs/ids" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "command": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
  }
}
