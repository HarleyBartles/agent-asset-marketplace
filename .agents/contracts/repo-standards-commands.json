{
  "apply": [
    ["@python", ".agents/standards/markdown-formatting/markdown-formatting/scripts/format_markdown.py", "--apply"],
    ["@python", "tools/run.py", "ci", "--apply", "--allow-shared-checkout"]
  ],
  "check": [
    ["@python", ".agents/standards/markdown-formatting/markdown-formatting/scripts/format_markdown.py", "--check"],
    ["@python", "tools/run.py", "ci", "--check", "--diagnostics"]
  ],
  "generated_paths": [
    ".agents/skills/**",
    "**/.provenance.json",
    ".agents/plugins/marketplace.json",
    "dist/plugin-roots.json",
    "dist/manifest.json"
  ]
}
