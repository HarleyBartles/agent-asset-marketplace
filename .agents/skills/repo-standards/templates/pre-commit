#!/usr/bin/env bash
# The pre-commit hook applies and verifies the repo's mechanical surfaces.
# It is installed by the repo-standards skill into .git/hooks/pre-commit.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if command -v py >/dev/null 2>&1; then
  py -3 tools/run.py ci --apply --allow-shared-checkout
elif command -v python3 >/dev/null 2>&1; then
  python3 tools/run.py ci --apply --allow-shared-checkout
elif command -v python >/dev/null 2>&1; then
  python tools/run.py ci --apply --allow-shared-checkout
else
  echo "py, python3, or python not found" >&2
  exit 1
fi

# Stage tracked files the hook may have regenerated.
git diff --name-only --diff-filter=M | while IFS= read -r file; do
  git add "$file"
done

# Stage canonical generated surfaces that may not yet be tracked.
git add INDEX.md 2>/dev/null || true
find . -name INDEX.md -not -path '*/.git/*' -exec git add {} + 2>/dev/null || true
git add INDEX.json 2>/dev/null || true
find . -name INDEX.json -not -path '*/.git/*' -exec git add {} + 2>/dev/null || true
git add .provenance.json 2>/dev/null || true
git add .agents/skills/.provenance.json 2>/dev/null || true
git add codex-marketplace/plugin-roots.json 2>/dev/null || true
git add .agents/plugins/marketplace.json 2>/dev/null || true
git add codex-marketplace/manifest.json 2>/dev/null || true
