{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Iterative review metrics",
  "description": "Evidence file for the iterative review graph. Recorded by the orchestrator at each metrics-track node.",
  "type": "object",
  "required": ["pr", "findings_by_node", "rounds_per_finding", "regressions", "total_rounds", "total_reviewer_subagent_dispatches", "devin_auto_review_invocations"],
  "properties": {
    "pr": {
      "type": "object",
      "required": ["branch", "base", "head_sha"],
      "properties": {
        "branch": {"type": "string"},
        "base": {"type": "string"},
        "head_sha": {"type": "string"}
      }
    },
    "findings_by_node": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "properties": {
        "preflight": {"type": "integer", "minimum": 0},
        "orchestrator-self-review": {"type": "integer", "minimum": 0},
        "lens-security": {"type": "integer", "minimum": 0},
        "lens-skills": {"type": "integer", "minimum": 0},
        "lens-marketplace": {"type": "integer", "minimum": 0},
        "strong-review": {"type": "integer", "minimum": 0},
        "regression-scan": {"type": "integer", "minimum": 0}
      }
    },
    "rounds_per_finding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "lens", "discovered_at_node", "discovered_at_round", "resolved_at_node", "resolved_at_round", "severity"],
        "properties": {
          "finding_id": {"type": "string"},
          "lens": {"type": "string"},
          "discovered_at_node": {"type": "string"},
          "discovered_at_round": {"type": "integer", "minimum": 1},
          "resolved_at_node": {"type": "string"},
          "resolved_at_round": {"type": "integer", "minimum": 1},
          "regression_of": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "important", "minor"]}
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fix_for", "new_finding", "discovered_at_node", "discovered_at_round", "severity"],
        "properties": {
          "fix_for": {"type": "string"},
          "new_finding": {"type": "string"},
          "discovered_at_node": {"type": "string"},
          "discovered_at_round": {"type": "integer", "minimum": 1},
          "severity": {"type": "string", "enum": ["blocking", "important", "minor"]}
        }
      }
    },
    "total_rounds": {"type": "integer", "minimum": 0},
    "total_reviewer_subagent_dispatches": {"type": "integer", "minimum": 0},
    "devin_auto_review_invocations": {"type": "integer", "minimum": 0}
  }
}
